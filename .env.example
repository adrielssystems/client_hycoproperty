# ==============================================================================
#   HYCO Property Management — Tenant Portal Environment Configuration
# ==============================================================================

PORT=3002
NODE_ENV=production

# Hikvision & Hik-Connect Cloud OpenAPI Credentials
HIKCONNECT_APP_KEY=your_hikconnect_app_key_here
HIKCONNECT_APP_SECRET=your_hikconnect_app_secret_here
HIKCONNECT_API_URL=https://open.hik-connect.com/artemis/api

# Database Centralized Access (Zero Double-Entry)
DATABASE_URL=postgresql://hyco_admin:hyco_password@localhost:5432/hycoproperty_db

# QuickBooks Online Bidirectional API
QBO_COMPANY_ID=your_qbo_realm_id
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret

# Management Contact Details
NEXT_PUBLIC_HYCO_PHONE=(317) 675-0041
NEXT_PUBLIC_HYCO_EMAIL=info@hycoprop.com
